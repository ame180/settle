# Image tag to run. The deploy workflow rewrites this line; set it by hand to roll back.
IMAGE_TAG=

# Public hostname, served by the reverse proxy.
APP_HOST=

# Generate secrets and passwords with: openssl rand -hex 32
# (Compose interpolates `$` in values, so hex keeps them safe.)
APP_SECRET=

# Only the mariadb service gets the root password; the app uses its own user.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=settle
MYSQL_USER=settle
MYSQL_PASSWORD=
