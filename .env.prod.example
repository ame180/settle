COMPOSE_PROJECT_NAME=settle

# Generate with: openssl rand -hex 32
APP_SECRET=

# Image tag to run; the deploy flow sets this.
IMAGE_TAG=latest

# Public hostname, picked up by nginx-proxy and acme-companion.
VIRTUAL_HOST=settle.example.com
# Docker network nginx-proxy is attached to.
PROXY_NETWORK=nginx-proxy

# Requests reach the app through nginx-proxy and the web container, both on private Docker networks.
SYMFONY_TRUSTED_PROXIES=PRIVATE_SUBNETS

# Only the mariadb service gets the root password; the app uses its own user.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=settle
MYSQL_USER=settle
MYSQL_PASSWORD=
MYSQL_HOST=mariadb
MYSQL_PORT=3306

MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

MAILER_DSN=null://null
