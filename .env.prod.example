# Generate secrets and passwords with: openssl rand -hex 32
# (Compose interpolates `$` in values, so hex keeps them safe.)
APP_SECRET=

# Only the mariadb service gets the root password; the app uses its own user.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=settle
MYSQL_USER=settle
MYSQL_PASSWORD=

# Host port the web container listens on.
NGINX_PORT=80
